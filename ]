use crate::models::assembly::AssemblyType;
use crate::models::symbol::{Symbol, Symbols};
use crate::models::typ::Type;
use rustc_hash::FxHashMap;

type AsmSymbols = FxHashMap<String, AsmSymbol>;

enum AsmSymbol {
    ObjEntry(AssemblyType, bool),
    FunEntry(bool),
}

fn backend_symbols(symbols: Symbols) -> AsmSymbols {
    symbols
        .iter()
        .map(|(name, symbol)| match symbol {
            Symbol::Func { defined, .. } => (name.clone(), AsmSymbol::FunEntry(*defined)),
            Symbol::StaticVar { typ, .. } => {
                (name.clone(), AsmSymbol::ObjEntry(typ.to_asm(), true))
            }
            Symbol::LocalVar { typ } => {
                (name.clone(), AsmSymbol::ObjEntry(to_asm_type(typ), false))
            }
        })
        .collect();
}
